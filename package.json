{
  "name": "calendar",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "change": "bun changeset",
    "version": "bun changeset version",
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --fail-if-no-match doc#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5"
  }
}
